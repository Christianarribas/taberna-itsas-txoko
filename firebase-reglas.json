{
  "rules": {
    ".read": false,
    ".write": false,
    "pedidos": {
      ".read": true,
      ".write": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['creado','mesa','tipo','platos','total','servido']) || newData.hasChild('servido')",
        "platos": { ".validate": "newData.val() == null || newData.hasChildren()" },
        "$otro": { ".validate": true }
      }
    },
    "reservas": {
      ".read": true,
      ".write": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['nombre','personas','dia','hora','creado']) && newData.child('nombre').val().length <= 60"
      }
    }
  }
}
